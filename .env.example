# ==============================================================================
# ORCHESTRA — Environment Configuration & Deployment Variables
# Track: Amazon Developer Hackathon 2026 — Alexa+ Track
# ==============================================================================
# Copy this file to .env for local overrides. Never commit actual .env files!

# ------------------------------------------------------------------------------
# 1. Mission Control Web Application Configuration
# ------------------------------------------------------------------------------
# Port for the Express Web server (default: 3000)
PORT=3000

# Host interface to bind the Web server to (0.0.0.0 for containers, 127.0.0.1 for local)
HOST=0.0.0.0

# Node environment mode (development | production | test)
NODE_ENV=production

# Persistent SQLite database file path.
# Set to a persistent volume path in production (e.g., /data/orchestra.db or ./data/orchestra.db).
# If omitted or set to :memory:, databases run in-memory and reset on restart.
DB_PATH=/data/orchestra.db
# ORCHESTRA_DB_PATH=/data/orchestra.db

# ------------------------------------------------------------------------------
# 2. Model Context Protocol (MCP) Server & Client Configuration
# ------------------------------------------------------------------------------
# Full URL to the MCP Streamable HTTP transport endpoint.
# In local standalone mode: http://127.0.0.1:3001/mcp
# In Docker Compose or container network: http://mcp-server:3001/mcp
MCP_SERVER_URL=http://127.0.0.1:3001/mcp

# MCP Server Host interface binding (127.0.0.1 for local isolation, 0.0.0.0 for container networks)
MCP_SERVER_HOST=0.0.0.0

# MCP Server Port (default: 3001)
MCP_SERVER_PORT=3001

# MCP Server Transport Endpoint Path (default: /mcp)
MCP_SERVER_ENDPOINT=/mcp

# MCP Server SQLite Database Path (default: :memory: or /data/mcp-tools.db)
MCP_DB_PATH=:memory:

# DNS Rebinding & Host Header Allowlist for MCP Server.
# Comma-separated list of additional allowed Host headers (e.g., mcp-server:3001,localhost:3001).
MCP_ALLOWED_HOSTS=mcp-server,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 3. Security & Access Control Boundary
# ------------------------------------------------------------------------------
# API key for trusted service-to-service API requests.
# When set, mutating endpoints require header 'Authorization: Bearer <key>' or 'x-api-key: <key>'.
# Leave unset in local development/isolated testing environments.
# REQUIRED when exposing the application beyond a private network/reverse-proxy boundary.
ORCHESTRA_API_KEY=

# Allowed origin for CORS (e.g., https://orchestra.example.com or * for local testing)
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 4. Browser Sessions & OAuth Credential Encryption
# ------------------------------------------------------------------------------
# Generate independent random secrets (for example: openssl rand -base64 32).
# SESSION_SECRET signs the HttpOnly per-browser session cookie and OAuth state binding.
SESSION_SECRET=
# Public browser origin used by OAuth connect routes for CSRF Origin validation.
PUBLIC_APP_ORIGIN=http://localhost:3000
# OAUTH_ENCRYPTION_KEY must be a base64-encoded 32-byte key for AES-256-GCM token encryption.
OAUTH_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 (User Sign-In & Resource Integrations)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# User sign-in redirect callback:
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Resource integration redirect callback (for Calendar, Gmail, Drive tools):
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# ------------------------------------------------------------------------------
# 6. GitHub App OAuth
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/oauth/github/callback
# Create/configure a GitHub App with read-only Contents and Metadata permissions.
# Add Issues: write only if explicitly enabling issue creation.
GITHUB_ISSUES_WRITE_ENABLED=false

# ------------------------------------------------------------------------------
# 7. Transactional Email Delivery (Email Verification & Password Reset)
# ------------------------------------------------------------------------------
# Resend (required for registration verification and password reset; https://resend.com)
RESEND_API_KEY=
AUTH_EMAIL_FROM=ORCHESTRA <noreply@your-verified-domain.example>
